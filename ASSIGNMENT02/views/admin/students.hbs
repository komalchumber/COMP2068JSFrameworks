<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>
    <h1>Students</h1>
    <a href="/admin/students/add">Add New Student</a>
    <ul>
        {{#each students}}
        <li>
            {{this.name}} - {{this.email}}
            <a href="/admin/students/edit/{{this._id}}">Edit</a>
            <form action="/admin/students/delete/{{this._id}}" method="post" style="display:inline;">
                <button type="submit">Delete</button>
            </form>
        </li>
        {{/each}}
    </ul>
</body>
</html>
