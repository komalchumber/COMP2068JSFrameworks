<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>
    <h1>Courses</h1>
    <a href="/admin/courses/add">Add New Course</a>
    <ul>
        {{#each courses}}
        <li>
            {{this.title}} - {{this.code}}
            <a href="/admin/courses/edit/{{this._id}}">Edit</a>
            <form action="/admin/courses/delete/{{this._id}}" method="post" style="display:inline;">
                <button type="submit">Delete</button>
            </form>
        </li>
        {{/each}}
    </ul>
</body>
</html>
