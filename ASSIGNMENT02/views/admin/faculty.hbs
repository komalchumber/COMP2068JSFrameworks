<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>
    <h1>Faculty</h1>
    <a href="/admin/faculty/add">Add New Faculty</a>
    <ul>
        {{#each faculty}}
        <li>
            {{this.name}} - {{this.email}} - {{this.department}}
            <a href="/admin/faculty/edit/{{this._id}}">Edit</a>
            <form action="/admin/faculty/delete/{{this._id}}" method="post" style="display:inline;">
                <button type="submit">Delete</button>
            </form>
        </li>
        {{/each}}
    </ul>
</body>
</html>
