<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>
    <h1>Projects</h1>
    <a href="/admin/projects/add">Add New Project</a>
    <ul>
        {{#each projects}}
        <li>
            {{this.title}}
            <a href="/admin/projects/edit/{{this._id}}">Edit</a>
            <form action="/admin/projects/delete/{{this._id}}" method="post" style="display:inline;">
                <button type="submit">Delete</button>
            </form>
        </li>
        {{/each}}
    </ul>
</body>
</html>
