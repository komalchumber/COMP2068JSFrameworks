<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>
    <h1>Edit Course</h1>
    <form action="/admin/courses/edit/{{course._id}}" method="post">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" value="{{course.title}}" required>
        <label for="code">Code:</label>
        <input type="text" id="code" name="code" value="{{course.code}}" required>
        <label for="description">Description:</label>
        <textarea id="description" name="description" required>{{course.description}}</textarea>
        <button type="submit">Update Course</button>
    </form>
</body>
</html>
