<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings</title>
    <link rel="stylesheet" href="/stylesheets/faculty.css">
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><a href="/faculty/dashboard">Dashboard</a></li>
                <li><a href="/faculty/manage-projects">Manage Projects</a></li>
                <li><a href="/faculty/profile">Profile</a></li>
                <li><a href="/faculty/notifications">Notifications</a></li>
                <li><a href="/faculty/settings">Settings</a></li>
                <li><a href="/logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1>Settings</h1>
        <form action="/faculty/settings/update" method="POST">
            <div class="form-group">
                <label for="theme">Theme</label>
                <select id="theme" name="theme">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                </select>
            </div>
            <div class="form-group">
                <label for="language">Language</label>
                <select id="language" name="language">
                    <option value="en">English</option>
                    <option value="es">Spanish</option>
                </select>
            </div>
            <button type="submit" class="btn">Update Settings</button>
        </form>
    </main>

    <footer>
        <p>&copy; 2024 University Project Management System</p>
    </footer>
</body>
</html>
