<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Dashboard</title>
    <link rel="stylesheet" href="/stylesheets/faculty.css">
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><a href="/faculty/dashboard">Dashboard</a></li>
                <li><a href="/faculty/manage-projects">Manage Projects</a></li>
                <li><a href="/faculty/profile">Profile</a></li>
                <li><a href="/faculty/notifications">Notifications</a></li>
                <li><a href="/faculty/settings">Settings</a></li>
                <li><a href="/logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1>Welcome to Your Dashboard, {{user.name}}</h1>
        <p>Here you can manage projects, update your profile, and stay informed with notifications.</p>
        
        <section class="quick-actions">
            <div>
                <h2>Manage Projects</h2>
                <a href="/faculty/manage-projects" class="btn">Go to Projects</a>
            </div>
            <div>
                <h2>Profile</h2>
                <a href="/faculty/profile" class="btn">Manage Profile</a>
            </div>
            <div>
                <h2>Notifications</h2>
                <a href="/faculty/notifications" class="btn">View Notifications</a>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2024 University Project Management System</p>
    </footer>
</body>
</html>
